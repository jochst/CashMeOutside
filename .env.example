# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cashmeoutside_db
POSTGRES_PORT=5432

# API Configuration
API_PORT=8000
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET_KEY=changeme_secret_key_for_jwt_tokens_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database URLs (auto-generated, but can be overridden)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cashmeoutside_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/cashmeoutside_db

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
